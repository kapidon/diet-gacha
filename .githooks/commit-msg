#!/bin/sh
# コミットメッセージが Conventional Commits の形式かを確認する。
# 有効にするには、クローンごとに一度だけ次を実行する:
#   git config core.hooksPath .githooks

first_line=$(head -1 "$1")

# マージとリバートは git が生成するので対象外
case "$first_line" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9-]+\))?!?: .+'

if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
  echo "コミットメッセージの形式が違います。"
  echo
  echo "  <type>(<scope>): <subject>"
  echo "  type  : feat fix docs style refactor perf test build ci chore"
  echo "  scope : 省略可。使うなら小文字とハイフン（例: habits）"
  echo "  破壊的変更は type のあとに ! を付ける（例: feat!:）"
  echo
  echo "実際のメッセージ: $first_line"
  exit 1
fi
