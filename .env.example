DATABASE_URL="postgresql://postgres:postgres@localhost:5433/diet_gacha_test"
# openssl rand -base64 32 で生成した値を入れる。
# 空のままだと本番（NODE_ENV=production）では better-auth が起動時に落ちる。
# npm run dev では better-auth 組み込みの既知のデフォルト値で黙って動いてしまうので、
# 空のまま気づかず開発を続けないよう、忘れずに値を入れること。
BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL は本番でのみ設定する（未設定ならリクエスト origin にフォールバックする）
